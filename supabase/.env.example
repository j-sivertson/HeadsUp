# Supabase Edge Functions Environment Variables
# Copy this file to .env and fill in your values

# Supabase project credentials (for edge functions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Surge SMS API credentials
# Get these from: https://app.surge.app
SURGE_API_TOKEN=your-surge-api-token
SURGE_ACCOUNT_ID=acct_your-account-id
SURGE_PHONE_NUMBER=+15551234567
SURGE_SIGNING_SECRET=your-webhook-signing-secret
