# HeadsUp Environment Variables
# Copy this file to .env.local and fill in your values.
# These must also be set in the Vercel dashboard for production deploys.

# Surge SMS API
SURGE_API_KEY=your_surge_api_key
SURGE_ACCOUNT_ID=your_surge_account_id
SURGE_WEBHOOK_SECRET=your_surge_webhook_signing_secret

# Tavily Web Search API
TAVILY_API_KEY=your_tavily_api_key

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase (optional — for future conversation persistence)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
